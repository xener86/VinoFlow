# Utilisé à la place de /.dockerignore pour le build de backend/Dockerfile
# (contexte = racine du dépôt) : on n'envoie que backend/ et db/.
*
!backend/
!db/
backend/node_modules
backend/**/*.test.js
backend/tests
backend/scripts
backend/*.tmp.*
backend/vitest.config.js
# Secrets du serveur (env_file sur le NAS) : jamais dans l'image
backend/.env
backend/.env.*
