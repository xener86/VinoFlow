# VinoFlow - Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ────────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────────
POSTGRES_USER=vinoflow
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=vinoflow
DATABASE_URL=postgresql://vinoflow:change_me_to_a_strong_password@db:5432/vinoflow

# ────────────────────────────────────────────
# Backend
# ────────────────────────────────────────────
PORT=3100
NODE_ENV=production

# Generate a long random string (e.g. `openssl rand -base64 48`)
# The backend WILL NOT START with a missing or default JWT_SECRET
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# URL where your frontend is accessible (used for CORS)
FRONTEND_URL=http://localhost:5001

# ────────────────────────────────────────────
# Comptes & sécurité
# ────────────────────────────────────────────
# VinoFlow est une cave de FOYER partagée : tous les comptes voient et
# modifient la même cave. Les inscriptions sont donc fermées par défaut ;
# seul le tout premier compte peut être créé librement (installation neuve).
# Passez à true le temps d'inscrire un membre du foyer, puis remettez false.
ALLOW_SIGNUP=false

# Nombre de reverse proxies devant le backend (nginx du conteneur frontend = 1).
# Mettez 2 si un Traefik/Caddy/NPM est placé devant VinoFlow, sinon le rate
# limiting verra tous les clients avec la même IP.
# TRUST_PROXY=1

# Accepter les clés IA saisies dans Paramètres (en-têtes x-vinoflow-*-key)
# quand le serveur n'a pas de clé. false = uniquement les variables ci-dessous.
# ALLOW_CLIENT_AI_KEYS=true

# ────────────────────────────────────────────
# Email (réinitialisation du mot de passe) — Sweego
# ────────────────────────────────────────────
# Sans SWEEGO_API_KEY, aucun email n'est envoyé : le lien de réinitialisation
# est écrit dans les logs du backend (`docker compose logs backend`).
# SWEEGO_API_KEY=your_sweego_api_key
# Expéditeur sur un domaine vérifié dans Sweego. "Nom <adresse>" accepté.
# MAIL_FROM=VinoFlow <cave@mail.example.com>
# URL publique utilisée dans les liens des emails (défaut : FRONTEND_URL)
# APP_URL=https://cave.example.com

# ────────────────────────────────────────────
# Sauvegardes (service backup → ./backups)
# ────────────────────────────────────────────
# BACKUP_HOUR=3
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# TZ=Europe/Paris

# ────────────────────────────────────────────
# AI Providers (Sommelier v2)
# ────────────────────────────────────────────
# At least one provider must be configured to use the sommelier.
# Defaults: Gemini Flash for criteria extraction, Claude Sonnet for argumentation.

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude — https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Override defaults per task (optional)
# VINOFLOW_PROVIDER_EXTRACT_CRITERIA=gemini
# VINOFLOW_PROVIDER_ARGUE=claude
# VINOFLOW_PROVIDER_ENRICH=claude
