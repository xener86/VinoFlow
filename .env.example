# VinoFlow - Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ────────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────────
POSTGRES_USER=vinoflow
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=vinoflow
DATABASE_URL=postgresql://vinoflow:change_me_to_a_strong_password@db:5432/vinoflow

# ────────────────────────────────────────────
# Backend
# ────────────────────────────────────────────
PORT=3100
NODE_ENV=production

# Generate a long random string (e.g. `openssl rand -base64 48`)
# The backend WILL NOT START with a missing or default JWT_SECRET
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# URL where your frontend is accessible (used for CORS)
FRONTEND_URL=http://localhost:5001

# ────────────────────────────────────────────
# Comptes & sécurité
# ────────────────────────────────────────────
# VinoFlow est une cave de FOYER partagée : tous les comptes voient et
# modifient la même cave. Les inscriptions sont donc fermées par défaut ;
# seul le tout premier compte peut être créé librement (installation neuve).
# Passez à true le temps d'inscrire un membre du foyer, puis remettez false.
ALLOW_SIGNUP=false

# Nombre de reverse proxies devant le backend (nginx du conteneur frontend = 1).
# Mettez 2 si un Traefik/Caddy/NPM est placé devant VinoFlow, sinon le rate
# limiting verra tous les clients avec la même IP.
# TRUST_PROXY=1

# Accepter les clés IA saisies dans Paramètres (en-têtes x-vinoflow-*-key)
# quand le serveur n'a pas de clé. false = uniquement les variables ci-dessous.
# ALLOW_CLIENT_AI_KEYS=true

# ────────────────────────────────────────────
# Email (réinitialisation du mot de passe) — Sweego
# ────────────────────────────────────────────
# Sans SWEEGO_API_KEY, aucun email n'est envoyé : le lien de réinitialisation
# est écrit dans les logs du backend (`docker compose logs backend`).
# SWEEGO_API_KEY=your_sweego_api_key
# Expéditeur sur un domaine vérifié dans Sweego. "Nom <adresse>" accepté.
# MAIL_FROM=VinoFlow <cave@mail.example.com>
# URL publique utilisée dans les liens des emails (défaut : FRONTEND_URL)
# APP_URL=https://cave.example.com

# ────────────────────────────────────────────
# Sauvegardes (service backup → ./backups)
# ────────────────────────────────────────────
# BACKUP_HOUR=3
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# TZ=Europe/Paris

# ────────────────────────────────────────────
# AI Providers (Sommelier v2)
# ────────────────────────────────────────────
# At least one provider must be configured to use the sommelier.
# Tâches et modèles par défaut :
#   extract-criteria, critique → Claude Haiku 4.5   (repli Gemini Flash)
#   argue                      → Claude Sonnet 5.5  (repli Gemini Flash)
#   enrich-aromas, enrich-peak → Claude Sonnet 5.5 + recherche web (pas de repli)
#   ocr                        → Gemini 3.8 Flash   (repli Claude Sonnet 5.5)
#   embedding                  → gemini-embedding-001 (768 dimensions)
# Coût des appels : GET /api/ai/usage (table ai_calls).

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude — https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Surcharges par tâche (optionnel) — TASK en majuscules, tirets → _ :
#   VINOFLOW_PROVIDER_<TASK>=claude|gemini   VINOFLOW_MODEL_<TASK>=...
#   VINOFLOW_MAX_TOKENS_<TASK>=...           VINOFLOW_EFFORT_<TASK>=low|medium|high
# VINOFLOW_PROVIDER_EXTRACT_CRITERIA=gemini
# VINOFLOW_MODEL_ARGUE=claude-sonnet-5-5
# VINOFLOW_EFFORT_ENRICH_AROMAS=medium
# VINOFLOW_MAX_TOKENS_VALUATION=4000
# ────────────────────────────────────────────
# Enrichissement des fiches (cascade de recherche web sourcée)
# ────────────────────────────────────────────
# Moteur principal : Claude Code embarqué dans l'image backend, sur votre
# abonnement Claude. Jeton (valable un an) à créer sur votre poste :
#   claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=
# auto (Claude Code si jeton, sinon API si ANTHROPIC_API_KEY) | claude-code | api | off
# ENRICH_ENGINE=auto
# Surveillance : nouveaux vins + revérification (mensuelle pour les fiches
# estimées d'après l'appellation ou une règle, trimestrielle d'après le
# producteur ou un autre millésime, annuelle pour les fiches exactes).
# ENRICH_TICK_MINUTES=60
# ENRICH_DAILY_LIMIT=30

# Sommelier en un seul appel avec outils (search_cellar, get_wine_details, get_peak)
# au lieu du pipeline extract → score → argue → critique. Activé par défaut ; nécessite
# ANTHROPIC_API_KEY, sinon (ou en cas d'erreur) repli automatique sur le pipeline.
# VINOFLOW_SOMMELIER_AGENT=false

# Repli serveur d'Anthropic en cas de refus (Sonnet 5.5) — désactivable :
# VINOFLOW_CLAUDE_SERVER_FALLBACK=false
